{
  "name": "cube-family",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && GITHUB_PAGES=true vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc -b",
    "build:native": "tsc -b && vite build --mode native",
    "check": "npm run lint && npm run format && npm run typecheck && npm run test && npm run check:catalogues",
    "e2e": "node scripts/visual-check.mjs",
    "build:e2e": "tsc -b && vite build --mode e2e --outDir dist-e2e",
    "check:catalogues": "node scripts/check-catalogues.mjs",
    "preformat": "node -e \"const fs=require('node:fs');import('prettier').then(async(p)=>{const f='src/render/equipment-models.ts';const s=fs.readFileSync(f,'utf8');const out=await p.format(s,{...(await p.resolveConfig(f)),filepath:f});console.log('CUBE_FORMATTED:'+Buffer.from(out).toString('base64'))})\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "puppeteer": "^25.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "simplex-noise": "^4.0.3",
    "three": "^0.185.1"
  },
  "description": "An endless voxel world of light — explore, dig and build, in the browser, on desktop and on phones."
}
